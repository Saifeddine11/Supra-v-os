{
  "expo": {
    "name": "Supra v OS",
    "slug": "supra-v-os",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "supravos",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "backgroundColor": "#F8F4EF",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#F8F4EF"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.suprav3.mobile"
    },
    "android": {
      "package": "com.suprav3.mobile",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#080706"
      }
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "@react-native-community/datetimepicker"
    ],
    "experiments": {
      "typedRoutes": false
    }
  }
}
