# Supabase — PUBLIC keys only. Same project as the web app.
# Copy to .env and fill with the values from Supabase Dashboard → Settings → API.
# NEVER put SUPABASE_SERVICE_ROLE_KEY, RESEND_API_KEY, OPENROUTER_API_KEY
# or any server secret in this file or anywhere in /mobile.
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your_publishable_or_anon_key

# Public web app base URL — used ONLY to build public notification links
# (link_url) so web users can click through. Never a secret.
EXPO_PUBLIC_WEB_APP_URL=https://app.suprav3.com
