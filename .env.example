# ============================================================================
# SUPRA V. AGENCY OS — ENVIRONMENT VARIABLES
# ============================================================================
# Copy to `.env.local` and fill with real values. Never commit `.env.local`.
# ============================================================================

# ─── SUPABASE (Dashboard → Settings → API) ──────────────────────────────────
# Project URL must be exactly https://<project-ref>.supabase.co (no /rest/v1/)
NEXT_PUBLIC_SUPABASE_URL=https://PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_publishable_or_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_secret_or_service_role_key

# Used by `npm run db:types` (same value as <project-ref> in the URL above)
SUPABASE_PROJECT_ID=PROJECT_REF

# ─── APP ─────────────────────────────────────────────────────────────────────
# Dev : http://localhost:3000 — Production : URL publique exacte (ex. https://app.suprav3.com).
# Utilisé pour inviteUserByEmail / resetPassword (redirectTo → …/login). Doit être autorisée dans
# Supabase Dashboard → Authentication → URL Configuration (Site URL + Redirect URLs).
NEXT_PUBLIC_APP_URL=http://localhost:3000

NEXT_PUBLIC_AGENCY_NAME=Supra v.
NEXT_PUBLIC_AGENCY_EMAIL=hello@suprav3.com
NEXT_PUBLIC_AGENCY_PHONE=+212 6 00 00 00 00
NEXT_PUBLIC_AGENCY_ADDRESS=Marrakech, Maroc

# ─── EMAIL (Resend — notifications app / crons) ───────────────────────────
# Les invitations Auth et reset passent par Supabase Auth (SMTP à configurer dans le dashboard Supabase).
# Voir docs/SUPABASE_AUTH_SMTP.md (Resend SMTP : smtp.resend.com, user resend, password = clé API).
RESEND_API_KEY=re_xxxxxxxxxxxxxxxx
EMAIL_FROM=Supra v. <noreply@example.com>
EMAIL_REPLY_TO=hello@example.com

# ─── CRON / BACKGROUND JOBS ─────────────────────────────────────────────────
# openssl rand -hex 32
CRON_SECRET=your_long_random_secret

# ─── DISCORD (Phase 1 — SUPRA → Discord, server-only) ───────────────────────
# Bot token from Discord Developer Portal → Bot. Never prefix with NEXT_PUBLIC_.
DISCORD_BOT_TOKEN=
# Guild where client categories/channels are created. Server Settings → Widget or
# Developer Mode → right-click the server → Copy Server ID.
DISCORD_GUILD_ID=
# Live task sync. Production: true. Do not turn this off for Phase 1.1 reminders.
DISCORD_TASK_SYNC_ENABLED=false
# Phase 1.1 operational reminders (due today, overdue, waiting_team, shooting).
# Keep false until verified. Independent of task-card sync.
DISCORD_OPERATIONAL_REMINDERS_ENABLED=false
# Discord user snowflake mentioned for waiting_team CEO validation.
# Production: CEO Mounir’s Discord user ID. Not resolved from employees
# (that row may be archived). Never prefix with NEXT_PUBLIC_.
DISCORD_VALIDATION_APPROVER_USER_ID=
# Stable Discord role snowflakes (Developer Mode → Roles → Copy Role ID).
# Used only for channel permission overwrites. Never matched by role name.
# Bot needs Manage Channels + Manage Roles (not Administrator). Bot role must
# sit above these roles in the server role list.
DISCORD_ROLE_DIRECTION=
DISCORD_ROLE_VIDEO_DIRECTOR=
DISCORD_ROLE_CAMERAMAN=
DISCORD_ROLE_EDITOR=
DISCORD_ROLE_COMMUNITY_MANAGER=
DISCORD_ROLE_MEDIA_BUYER=
DISCORD_ROLE_WEB_TECH=
# Whole SUPRA team — chat-général. If empty, chat-général allows the union of
# the specialist roles above plus Direction.
DISCORD_ROLE_TEAM=
# End-of-day compte-rendu (18:00 ask / 18:30 missing). Keep false until tested.
# Channel IDs: Developer Mode → right-click the channel → Copy Channel ID.
# Never matched by name at runtime.
DISCORD_DAILY_REPORT_REMINDER_ENABLED=false
DISCORD_TEAM_GENERAL_CHANNEL_ID=
DISCORD_TEAM_REPORT_CHANNEL_ID=
