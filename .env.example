# ============================================================================
# SUPRA V. AGENCY OS — ENVIRONMENT VARIABLES
# ============================================================================
# Copy to `.env.local` and fill with real values. Never commit `.env.local`.
# ============================================================================

# ─── SUPABASE (Dashboard → Settings → API) ──────────────────────────────────
# Project URL must be exactly https://<project-ref>.supabase.co (no /rest/v1/)
NEXT_PUBLIC_SUPABASE_URL=https://PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_publishable_or_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_secret_or_service_role_key

# Used by `npm run db:types` (same value as <project-ref> in the URL above)
SUPABASE_PROJECT_ID=PROJECT_REF

# ─── APP ─────────────────────────────────────────────────────────────────────
# Dev : http://localhost:3000 — Production : URL publique exacte (ex. https://app.suprav3.com).
# Utilisé pour inviteUserByEmail / resetPassword (redirectTo → …/login). Doit être autorisée dans
# Supabase Dashboard → Authentication → URL Configuration (Site URL + Redirect URLs).
NEXT_PUBLIC_APP_URL=http://localhost:3000

NEXT_PUBLIC_AGENCY_NAME=Supra v.
NEXT_PUBLIC_AGENCY_EMAIL=hello@suprav3.com
NEXT_PUBLIC_AGENCY_PHONE=+212 6 00 00 00 00
NEXT_PUBLIC_AGENCY_ADDRESS=Marrakech, Maroc

# ─── EMAIL (Resend — notifications app / crons) ───────────────────────────
# Les invitations Auth et reset passent par Supabase Auth (SMTP à configurer dans le dashboard Supabase).
# Voir docs/SUPABASE_AUTH_SMTP.md (Resend SMTP : smtp.resend.com, user resend, password = clé API).
RESEND_API_KEY=re_xxxxxxxxxxxxxxxx
EMAIL_FROM=Supra v. <noreply@example.com>
EMAIL_REPLY_TO=hello@example.com

# ─── CRON / BACKGROUND JOBS ─────────────────────────────────────────────────
# openssl rand -hex 32
CRON_SECRET=your_long_random_secret

# ─── DISCORD (Phase 1 — SUPRA → Discord, server-only) ───────────────────────
# Bot token from Discord Developer Portal → Bot. Never prefix with NEXT_PUBLIC_.
DISCORD_BOT_TOKEN=
# Live task sync. Leave false until channel routes are configured and the test
# message on POST /api/discord/admin succeeds. Then set true.
DISCORD_TASK_SYNC_ENABLED=false
