# SUPRA V3 Reels Worker — environment
# Copy to worker/.env and fill in. NEVER commit real secrets.

# Supabase (service role — server-side only, bypasses RLS)
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# Storage buckets (must match the app)
STUDIO_SOURCE_BUCKET=reels-source
STUDIO_MEDIA_BUCKET=reels-media

# AI clip discovery (OpenRouter — same provider as the app)
OPENROUTER_API_KEY=YOUR_OPENROUTER_KEY
AI_MODEL=openrouter/auto

# Transcription (faster-whisper)
# Model: tiny | base | small | medium | large-v3  (larger = better FR, slower)
WHISPER_MODEL=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
WHISPER_LANGUAGE=fr
PYTHON_BIN=python3

# FFmpeg binaries (leave as default if on PATH)
FFMPEG_BIN=ffmpeg
FFPROBE_BIN=ffprobe

# Worker tuning
WORKER_ID=worker-local-1
POLL_INTERVAL_MS=3000
PROXY_HEIGHT=720
WORK_DIR=/tmp/supra-reels
